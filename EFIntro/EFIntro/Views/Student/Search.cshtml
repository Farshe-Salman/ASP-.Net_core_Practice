
@{
    ViewBag.Title = "Search";
}

<h2>Search</h2>

<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Department</th>
        <th>Dept ID</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>@item.Department</td>
            <td>@item.DeptID</td>
        </tr>

    }
</table>
