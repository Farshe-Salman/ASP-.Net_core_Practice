
@{
    ViewBag.Title = "Create";
}

<h2>Create Teacher Account</h2>

<form method="post">
    <input class="form form-control form-check" type="text" name="Name" placeholder="Teacher's Name" />
    <br />
    <input class="form form-control" type="text" name="Department" placeholder="Department" />
    <br />
    <input class="form form-control" type="text" name="Room_No" placeholder="Room Number" />
    <br />
    <input  type="submit" value="Create" class="btn btn-primary" />
</form>
