
@{
    ViewBag.Title = "Search";
}

<h2>Search</h2>



    <table>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Age</td>
                <td>@item.Department</td>
                <td>@item.DeptID</td>
            </tr>
        }
    </table>


